diff --git a/crates/tinywasm/src/lib.rs b/crates/tinywasm/src/lib.rs
index 47da470..d6a1c21 100644
--- a/crates/tinywasm/src/lib.rs
+++ b/crates/tinywasm/src/lib.rs
@@ -135,6 +135,32 @@ mod reference;
 mod shared;
 mod store;
 
+#[cfg(feature = "op-histogram")]
+#[doc(hidden)]
+pub mod op_histogram {
+    //! Local profiling aid: counts dispatched (previous, next) opcode pairs.
+    use core::sync::atomic::{AtomicU64, Ordering::Relaxed};
+    use tinywasm_types::InstructionOpcode;
+    const N: usize = InstructionOpcode::COUNT + 1;
+    static PAIRS: [[AtomicU64; N]; N] = [const { [const { AtomicU64::new(0) }; N] }; N];
+    #[inline(always)]
+    pub(crate) fn record(prev: usize, next: usize) {
+        PAIRS[prev][next].fetch_add(1, Relaxed);
+    }
+    /// (previous, next, count) for every nonzero pair; previous == "<entry>" when dispatch
+    /// re-entered from the run loop.
+    pub fn take() -> alloc::vec::Vec<(&'static str, &'static str, u64)> {
+        let name = |i: usize| if i == InstructionOpcode::COUNT { "<entry>" } else { InstructionOpcode::NAMES[i] };
+        let mut out = alloc::vec::Vec::new();
+        for (p, row) in PAIRS.iter().enumerate() {
+            for (n, c) in row.iter().enumerate() {
+                let c = c.swap(0, Relaxed);
+                if c != 0 { out.push((name(p), name(n), c)); }
+            }
+        }
+        out
+    }
+}
 mod interpreter;
 use interpreter::InterpreterRuntime;
 
