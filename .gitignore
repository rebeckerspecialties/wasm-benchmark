# --- Build artifacts ---
/target/
**/target/

# --- Xcode build outputs ---
/apps/build/
/apps/out/
**/xcuserdata/
**/*.xcuserstate
/apps/DerivedData*/
**/DerivedData*/
*.dSYM/

# --- wasmtime working clone ---
# 47 GB working clone, not a submodule (multiple active branches, too heavy
# for fresh-clone reproducibility). Set up per AGENTS.md → wasmtime section.
/wasmtime/

# --- Experiment outputs (large, mostly machine-generated) ---
# All raw trace bundles, large XML exports, run logs, and intermediate
# binaries. Any summary .md worth preserving has been promoted to docs/.
/out/

# --- Loose trace bundles anywhere ---
**/*.trace/
**/*.trace
Launch_*

# --- graphql-validation built artifacts ---
# The .wat (~458 MB), linked .component.wasm (~29 MB), node_modules, and
# the porffor-tests harness are reproducible from
# workloads/graphql-validation/{assemblyscript,porffor}/.
/workloads/graphql-validation/decomposed/
/workloads/graphql-validation/graphql-validation.component.wasm
/workloads/graphql-validation/driver.bundle.mjs
/workloads/graphql-validation/node_modules/
/workloads/graphql-validation/porffor-tests/
/workloads/graphql-validation/**/node_modules/
/workloads/graphql-validation/**/dist/

# --- Editor / OS / tooling ---
.DS_Store
*.swp
*.swo
.idea/
.vscode/
.claude/

# --- Reference clones not part of the build ---
# StarlingMonkey was cloned to inspect builtins/web/crypto/crypto-algorithm.h
# as a reference for vtable_dispatch.rs design. Not part of any build path.
/StarlingMonkey/
