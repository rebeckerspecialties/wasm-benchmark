index 2039c7de8d..8eb8625e59 100644
--- a/cranelift/codegen/src/isa/pulley_shared/lower.rs
+++ b/cranelift/codegen/src/isa/pulley_shared/lower.rs
@@ -4,7 +4,8 @@ pub mod isle;
 
