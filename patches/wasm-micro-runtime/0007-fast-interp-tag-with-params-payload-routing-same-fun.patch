@@ -12445,19 +12455,6 @@ re_scan:
                 uint32 tag_index = 0;
                 pb_read_leb_int32(p, p_end, tag_index);
 
-#if WASM_ENABLE_FAST_INTERP != 0
-                /* Fast-interp: the LEB-encoded tag_index from the source
-                 * bytecode is consumed above; re-emit it as a plain
