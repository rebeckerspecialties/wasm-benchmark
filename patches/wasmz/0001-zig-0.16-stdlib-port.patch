-    mutex: std.Thread.Mutex = .{},
-    cond: std.Thread.Condition = .{},
+    mutex: StubMutex = .{},
+    cond: StubCondition = .{},
     waiters: u32 = 0,
     notify_seq: u32 = 0,
 };
