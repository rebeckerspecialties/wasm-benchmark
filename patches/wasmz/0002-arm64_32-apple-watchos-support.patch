From e93db18d749cb9d8c1d8b4a676e93ce76fda387c Mon Sep 17 00:00:00 2001
From: Matt Hargett <plaztiksyke@gmail.com>
Date: Tue, 22 Sep 2026 16:41:37 -0700
Subject: Enable arm64_32-apple-watchos (aarch64-watchos-ilp32) build

Zig 0.16's std.Io.Threaded does not compile under ILP32 (u64 -> usize
narrowing, align(4) header casts), so on 32-bit-pointer targets keep
every reference to it out of the C API static library:

- build.zig: single_threaded static lib for the ILP32 target.
- capi.zig: a trapping panic handler (upstream's FullPanic handler
  prints through std.debug and stays on 64-bit targets), a no-op logFn,
  std_options_debug_io = std.Io.failing, and std.Io.failing as the
  store's Io (it backs WASI only; plain-wasm embedding is unaffected).

Rebased onto v0.1.4, which added its own panic handler and the
Store.init(io) parameter; both are now chosen by pointer width.
---
 build.zig    |   7 +++
 src/capi.zig | 134 ++++++++++++++++++++++++++++++++++++++++++++++++++-
 2 files changed, 139 insertions(+), 2 deletions(-)

diff --git a/build.zig b/build.zig
index c828fd7..7c37f00 100644
--- a/build.zig
+++ b/build.zig
@@ -279,6 +279,7 @@ pub fn build(b: *std.Build) void {
             .root_source_file = b.path("src/capi.zig"),
             .target = target,
             .optimize = optimize,
+            .single_threaded = true,
             .imports = &.{
                 .{ .name = "wasmz", .module = mod },
             },
@@ -303,6 +304,12 @@ pub fn build(b: *std.Build) void {
     // Mirrors the wasm-benchmark project convention (`zwasm` exposes the
     // same `static-lib` step) so `scripts/build-wasmz.sh` can call it
     // without a special case.
+    //
+    // single_threaded = true eliminates the `if (!builtin.single_threaded)`
+    // branch in vm/handlers/memory.zig that pulls in std.debug.print →
+    // std.Io.Threaded (which doesn't compile on arm64_32-watchos due to
+    // u64→usize narrowing errors). Embedders that need threads can build
+    // the dynamic `clib` variant instead.
     const clib_static = b.addLibrary(.{
         .name = "wasmz",
         .linkage = .static,
diff --git a/src/capi.zig b/src/capi.zig
index f73eab0..444aed4 100644
--- a/src/capi.zig
+++ b/src/capi.zig
@@ -15,6 +15,123 @@
 const std = @import("std");
 const wasmz = @import("wasmz");
 
+// On arm64_32-apple-watchos (32-bit-pointer aarch64) Zig 0.16's
+// default panic / std.debug machinery hits `u64 → usize` narrowing
+// errors in std.Io.Threaded.dirReadDarwin et al. Even
+// `std.debug.simple_panic` still routes through `lockStderr →
+// std_options.debug_io → debug_threaded_io.io()` which pulls in the
+// whole std.Io.Threaded module. Same applies to std.log.defaultLog,
+// which is what wasmz/instance.zig:813 ends up calling via std.log.err.
+// We override BOTH `panic` and `std_options.logFn` to trap/no-op so
+// arm64_32-apple-watchos finally compiles without a single Zig-stdlib
+// patch.
+//
+// Harmless on other targets — they just lose pretty panic messages
+// and runtime log output (wasmz already routes errors through C-ABI
+// wasmz_error_t, not stderr, so the C consumer never sees the loss).
+fn traping_panic(_: []const u8, _: ?usize) noreturn {
+    @trap();
+}
+const ilp32_panic = struct {
+    pub const call = traping_panic;
+    pub fn sentinelMismatch(_: anytype, _: anytype) noreturn {
+        @trap();
+    }
+    pub fn unwrapError(_: anyerror) noreturn {
+        @trap();
+    }
+    pub fn outOfBounds(_: usize, _: usize) noreturn {
+        @trap();
+    }
+    pub fn startGreaterThanEnd(_: usize, _: usize) noreturn {
+        @trap();
+    }
+    pub fn inactiveUnionField(_: anytype, _: anytype) noreturn {
+        @trap();
+    }
+    pub fn sliceCastLenRemainder(_: usize) noreturn {
+        @trap();
+    }
+    pub fn reachedUnreachable() noreturn {
+        @trap();
+    }
+    pub fn unwrapNull() noreturn {
+        @trap();
+    }
+    pub fn castToNull() noreturn {
+        @trap();
+    }
+    pub fn incorrectAlignment() noreturn {
+        @trap();
+    }
+    pub fn invalidErrorCode() noreturn {
+        @trap();
+    }
+    pub fn integerOutOfBounds() noreturn {
+        @trap();
+    }
+    pub fn integerOverflow() noreturn {
+        @trap();
+    }
+    pub fn shlOverflow() noreturn {
+        @trap();
+    }
+    pub fn shrOverflow() noreturn {
+        @trap();
+    }
+    pub fn divideByZero() noreturn {
+        @trap();
+    }
+    pub fn exactDivisionRemainder() noreturn {
+        @trap();
+    }
+    pub fn integerPartOutOfBounds() noreturn {
+        @trap();
+    }
+    pub fn corruptSwitch() noreturn {
+        @trap();
+    }
+    pub fn shiftRhsTooBig() noreturn {
+        @trap();
+    }
+    pub fn invalidEnumValue() noreturn {
+        @trap();
+    }
+    pub fn forLenMismatch() noreturn {
+        @trap();
+    }
+    pub fn copyLenMismatch() noreturn {
+        @trap();
+    }
+    pub fn memcpyAlias() noreturn {
+        @trap();
+    }
+    pub fn noreturnReturned() noreturn {
+        @trap();
+    }
+};
+
+fn noopLog(
+    comptime _: std.log.Level,
+    comptime _: @EnumLiteral(),
+    comptime _: []const u8,
+    _: anytype,
+) void {}
+
+/// `std.debug.print` (reached from e.g. the memory.grow handler's error path)
+/// writes through `std_options_debug_io`; its default is std.Io.Threaded,
+/// which does not compile under ILP32 on Zig 0.16.
+pub const std_options_debug_io: std.Io = if (@sizeOf(usize) < 8)
+    std.Io.failing
+else
+    std.Io.Threaded.global_single_threaded.io();
+
+pub const std_options: std.Options = .{
+    .allow_stack_tracing = false,
+    .networking = false,
+    .logFn = noopLog,
+};
+
 const Engine = wasmz.Engine;
 const Config = wasmz.Config;
 const Module = wasmz.Module;
@@ -41,7 +158,11 @@ const alloc = std.heap.page_allocator;
 /// `std.debug.SelfInfo` out of the archive, which on windows-msvc would
 /// otherwise need `LdrRegisterDllNotification` — a symbol the Windows SDK's
 /// ntdll import library does not provide.
-pub const panic = std.debug.FullPanic(struct {
+///
+/// On 32-bit-pointer targets (arm64_32-apple-watchos) even this handler's
+/// `std.debug.print` pulls in std.Io.Threaded, which does not compile under
+/// ILP32 on Zig 0.16, so those targets use the trapping handler above.
+pub const panic = if (@sizeOf(usize) < 8) ilp32_panic else std.debug.FullPanic(struct {
     fn call(msg: []const u8, _: ?usize) noreturn {
         std.debug.print("wasmz: panic: {s}\n", .{msg});
         std.process.abort();
@@ -255,13 +376,22 @@ const CStore = struct {
     }
 };
 
+/// The store's `std.Io` backs WASI only. On 32-bit-pointer targets
+/// (arm64_32-apple-watchos) std.Io.Threaded does not compile under ILP32 on
+/// Zig 0.16, so those targets get `std.Io.failing`: WASI calls fail cleanly,
+/// plain-wasm embedding is unaffected.
+fn store_io() std.Io {
+    if (comptime @sizeOf(usize) < 8) return std.Io.failing;
+    return std.Io.Threaded.global_single_threaded.io();
+}
+
 export fn wasmz_store_new(engine_handle: ?*wasmz_engine_t) ?*wasmz_store_t {
     const eh = engine_handle orelse return null;
     const eng: *Engine = @ptrCast(@alignCast(eh.ptr));
 
     const cstore = alloc.create(CStore) catch return null;
     cstore.* = .{
-        .store = Store.init(alloc, eng.*, std.Io.Threaded.global_single_threaded.io()) catch {
+        .store = Store.init(alloc, eng.*, store_io()) catch {
             alloc.destroy(cstore);
             return null;
         },
