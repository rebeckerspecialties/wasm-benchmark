+;;       push_frame
+;;       xconst8 x0, 2
+;;       pop_frame
+;;       ret
+;;
+;; wasm[0]::function[2]::f3:
+;;       push_frame
+;;       xconst8 x0, 3
+;;       pop_frame
+;;       ret
+;;
+;; wasm[0]::function[3]:
+;;       push_frame_save 16, x16, x19
+;;       xmov x3, x0
+;;       br_if_xugteq32_u8 x2, 3, 0x7d    // target = 0x96
+;;   20: xload64le_o32 x0, x0, 48
+;;       zext32 x1, x2
+;;       xmov x19, x2
+;;       xshl64_u6 x2, x1, 3
+;;       xadd64 x0, x0, x2
+;;       xload64le_o32 x0, x0, 0
+;;       xband64_s8_br_if_not_x64 x0, x0, -2, 0x4a    // target = 0x84
+;;   42: xmov x16, x3
