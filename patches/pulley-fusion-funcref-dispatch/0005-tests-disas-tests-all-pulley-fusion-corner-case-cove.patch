+;;   4c: xload32le_o32 x1, x0, 16
+;;       xload64le_o32 x2, x16, 40
+;;       xload32le_o32 x2, x2, 0
+;;       br_if_xneq32 x1, x2, 0x3b    // target = 0x9c
+;;   68: xload64le_o32 x3, x0, 8
+;;       xload64le_o32 x0, x0, 24
