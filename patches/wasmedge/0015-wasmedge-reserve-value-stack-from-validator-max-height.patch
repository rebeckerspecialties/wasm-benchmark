From: Matt Hargett <plaztiksyke@gmail.com>
Date: Tue, 22 Sep 2026 16:27:30 -0700
Subject: wasmedge reserve value stack from validator max height

Rebased onto 0.17.2-rc.3: context-only conflicts with the #4850 comment
sweep in function.h.
---
 include/ast/segment.h                 |  8 ++++++++
 include/runtime/instance/function.h   | 19 +++++++++++++++----
 include/runtime/stackmgr.h            |  7 +++++++
 include/validator/formchecker.h       |  4 ++++
 lib/executor/helper.cpp               |  3 +++
 lib/executor/instantiate/function.cpp |  3 ++-
 lib/validator/formchecker.cpp         |  6 +++++-
 lib/validator/validator.cpp           |  4 ++++
 8 files changed, 48 insertions(+), 6 deletions(-)

diff --git a/include/ast/segment.h b/include/ast/segment.h
index 7c8d4e47a..eeb58a822 100644
--- a/include/ast/segment.h
+++ b/include/ast/segment.h
@@ -116,12 +116,20 @@ public:
   const auto &getSymbol() const noexcept { return FuncSymbol; }
   void setSymbol(Symbol<void> S) noexcept { FuncSymbol = std::move(S); }
 
+  uint32_t getMaxValueStackHeight() const noexcept {
+    return MaxValueStackHeight;
+  }
+  void setMaxValueStackHeight(uint32_t Height) noexcept {
+    MaxValueStackHeight = Height;
+  }
+
 private:
   /// \name Data of CodeSegment node.
   /// @{
   uint32_t SegSize = 0;
   std::vector<std::pair<uint32_t, ValType>> Locals;
   Symbol<void> FuncSymbol;
+  uint32_t MaxValueStackHeight = 0;
   /// @}
 };
 
diff --git a/include/runtime/instance/function.h b/include/runtime/instance/function.h
index 5b94f27d9..5f4371619 100644
