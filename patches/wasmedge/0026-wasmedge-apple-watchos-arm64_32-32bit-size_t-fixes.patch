From 2fc5fea37540ca4d41a8ff88daa6bfc2dee40260 Mon Sep 17 00:00:00 2001
From: Matt Hargett <plaztiksyke@gmail.com>
Date: Tue, 22 Sep 2026 16:29:01 -0700
Subject: wasmedge apple watchos arm64_32 32bit size_t fixes

---
 include/runtime/instance/function.h | 6 +++---
 include/runtime/instance/memory.h   | 3 ++-
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/include/runtime/instance/function.h b/include/runtime/instance/function.h
index 5f933eba0..115e46c13 100644
--- a/include/runtime/instance/function.h
+++ b/include/runtime/instance/function.h
@@ -168,12 +168,12 @@ public:
 
     struct FuncTypeKeyHash {
       size_t operator()(const FuncTypeKey &Key) const noexcept {
-        size_t Hash = 1469598103934665603ULL;
+        uint64_t Hash = 1469598103934665603ULL;
         for (const auto Word : Key.Words) {
-          Hash ^= static_cast<size_t>(Word);
+          Hash ^= static_cast<uint64_t>(Word);
           Hash *= 1099511628211ULL;
         }
-        return Hash;
+        return static_cast<size_t>(Hash);
       }
     };
 
diff --git a/include/runtime/instance/memory.h b/include/runtime/instance/memory.h
index 64e9a8008..fa40dfcd6 100644
--- a/include/runtime/instance/memory.h
+++ b/include/runtime/instance/memory.h
@@ -336,7 +336,8 @@ public:
     if (unlikely(!checkAccessBound(Offset, Size))) {
       return {};
     }
-    return {reinterpret_cast<const char *>(&DataPtr[Offset]), Size};
+    return {reinterpret_cast<const char *>(&DataPtr[Offset]),
+            static_cast<size_t>(Size)};
   }
 
   /// Template for loading bytes and converting them to a value.
