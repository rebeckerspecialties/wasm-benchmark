+Expect<void> Executor::runLocalGetI32LoadLocalTeeOp(
+    Runtime::StackManager &StackMgr, const AST::Instruction &Instr,
+    AST::InstrView::iterator &PC) const noexcept {
+  auto *MemInst = getMemInstByIdx(StackMgr, Instr.getInternalArgument0());
+  assuming(MemInst);
+
+  const uint32_t PackedOffsets = Instr.getInternalArgument2();
+  const uint32_t BaseStackOffset = unpackLowStackOffset(PackedOffsets);
+  const uint32_t TeeStackOffset = unpackHighStackOffset(PackedOffsets);
+  const auto AddrType = MemInst->getMemoryType().getLimit().getAddrType();
+  const uint64_t Base =
+      extractAddr(StackMgr.getTopN(BaseStackOffset), AddrType);
+  const uint64_t Offset = Instr.getInternalArgument1();
+
+  StackMgr.push(uint32_t(0));
+  ValVariant &Val = StackMgr.getTop();
+  if (likely(MemInst->canUseGuardPageBoundsCheck())) {
+    MemInst->loadValueUnchecked<uint32_t, 4>(Val.emplace<uint32_t>(),
+                                             Base + Offset);
+    StackMgr.getTopN(TeeStackOffset) = Val;
+    PC += 2;
+    return {};
+  }
+
+  uint64_t EA = 0;
+#if defined(_MSC_VER) && !defined(__clang__)
+  if (std::numeric_limits<uint64_t>::max() - Offset < Base) {
+    EA = Base + Offset;
+#else
+  if (unlikely(__builtin_add_overflow(Base, Offset, &EA))) {
+#endif
+    spdlog::error(ErrCode::Value::MemoryOutOfBounds);
+    spdlog::error(ErrInfo::InfoBoundary(EA, 4, MemInst->getSize(), true));
+    spdlog::error(
+        ErrInfo::InfoInstruction(OpCode::I32__load, Instr.getOffset()));
+    return Unexpect(ErrCode::Value::MemoryOutOfBounds);
+  }
+
+  auto LoadResult =
+      MemInst->loadValue<uint32_t, 4>(Val.emplace<uint32_t>(), EA)
+          .map_error([&Instr](auto E) {
+            spdlog::error(
+                ErrInfo::InfoInstruction(OpCode::I32__load, Instr.getOffset()));
+            return E;
+          });
+  if (unlikely(!LoadResult)) {
+    return Unexpect(LoadResult.error());
+  }
   StackMgr.getTopN(TeeStackOffset) = Val;
   PC += 2;
   return {};
diff --git a/lib/executor/superinstr.cpp b/lib/executor/superinstr.cpp
--- a/lib/executor/superinstr.cpp
+++ b/lib/executor/superinstr.cpp
@@ -28,6 +28,32 @@
 void FunctionInstance::fuseSuperInstructions(AST::InstrVec &Instrs) noexcept {
   for (size_t I = 0; I < Instrs.size(); ++I) {
     if (Instrs[I].getOpCode() != OpCode::Local__get) {
+      continue;
+    }
+
+    if (I + 3 < Instrs.size() &&
+        Instrs[I + 1].getOpCode() == OpCode::I32__const &&
+        Instrs[I + 2].getOpCode() == OpCode::I32__add &&
+        Instrs[I + 3].getOpCode() == OpCode::I32__load &&
+        Instrs[I + 3].getMemoryOffset() <=
+            std::numeric_limits<uint32_t>::max() &&
+        canPackStackOffsets(Instrs[I].getStackOffset(),
+                            Instrs[I + 3].getTargetIndex())) {
+      AST::Instruction Fused(OpCode::Internal__LocalGetI32ConstAddI32Load,
+                             Instrs[I + 3].getOffset());
+      Fused.getInternalArgument0() = Instrs[I + 1].getNum().get<uint32_t>();
+      Fused.getInternalArgument1() = packStackOffsets(
+          Instrs[I].getStackOffset(), Instrs[I + 3].getTargetIndex());
+      Fused.getInternalArgument2() =
+          static_cast<uint32_t>(Instrs[I + 3].getMemoryOffset());
+      Instrs[I] = std::move(Fused);
+      Instrs[I + 1] =
+          AST::Instruction(OpCode::Nop, Instrs[I + 1].getOffset());
+      Instrs[I + 2] =
+          AST::Instruction(OpCode::Nop, Instrs[I + 2].getOffset());
+      Instrs[I + 3] =
+          AST::Instruction(OpCode::Nop, Instrs[I + 3].getOffset());
+      I += 3;
       continue;
     }
 
