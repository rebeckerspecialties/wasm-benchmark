+class CxxAPIHostFunc : public Runtime::HostFunctionBase {
+public:
+  CxxAPIHostFunc(const AST::FunctionType *Type, WasmEdge_HostFuncCxx_t FuncPtr,
+                 void *ExtData, const uint64_t FuncCost = 0) noexcept
+      : Runtime::HostFunctionBase(FuncCost), Func(FuncPtr), Data(ExtData) {
+    DefType.getCompositeType().getFuncType() = *Type;
+  }
+  ~CxxAPIHostFunc() noexcept override = default;
+
+  Expect<void> run(const Runtime::CallingFrame &CallFrame,
+                   Span<const ValVariant> Args,
+                   Span<ValVariant> Rets) override {
+    static_assert(sizeof(ValVariant) == sizeof(uint128_t));
+    static_assert(alignof(ValVariant) == alignof(uint128_t));
+    auto *CallFrameCxt = toCallFrameCxt(&CallFrame);
+    WasmEdge_Result Stat =
+        Func(Data, CallFrameCxt,
+             reinterpret_cast<const uint128_t *>(Args.data()),
+             reinterpret_cast<uint128_t *>(Rets.data()));
+    if (WasmEdge_ResultOK(Stat)) {
+      if (WasmEdge_ResultGetCode(Stat) == 0x01U) {
+        return Unexpect(ErrCode::Value::Terminated);
+      }
+    } else {
+      return Unexpect(
+          static_cast<ErrCategory>(WasmEdge_ResultGetCategory(Stat)),
+          WasmEdge_ResultGetCode(Stat));
+    }
+    return {};
+  }
+
+private:
+  WasmEdge_HostFuncCxx_t Func;
+  void *Data;
+};
