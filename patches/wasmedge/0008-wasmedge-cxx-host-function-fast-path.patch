+WASMEDGE_CAPI_EXPORT WasmEdge_FunctionInstanceContext *
+WasmEdge_FunctionInstanceCreateCxx(const WasmEdge_FunctionTypeContext *Type,
+                                   WasmEdge_HostFuncCxx_t HostFunc, void *Data,
+                                   const uint64_t Cost) noexcept {
+  try {
+    if (Type && HostFunc) {
+      return toFuncCxt(new WasmEdge::Runtime::Instance::FunctionInstance(
+          std::make_unique<CxxAPIHostFunc>(fromFuncTypeCxt(Type), HostFunc,
+                                           Data, Cost)));
+    }
+  } catch (...) {
+    handleCAPIError();
+  }
+  return nullptr;
+}
