+void clearThreadLocalErrorMessages() { ThreadLocalErrorMessages.clear(); }
+
+std::string takeThreadLocalErrorMessages() {
+  if (ThreadLocalErrorMessages.empty()) {
+    return {};
+  }
+  std::string Message;
+  size_t TotalSize = 0;
+  for (const std::string &Line : ThreadLocalErrorMessages) {
+    TotalSize += Line.size();
+  }
+  TotalSize += ThreadLocalErrorMessages.size() - 1;
+  Message.reserve(TotalSize);
+  for (size_t Index = 0; Index < ThreadLocalErrorMessages.size(); ++Index) {
+    if (Index != 0) {
+      Message.push_back('\n');
+    }
+    Message += ThreadLocalErrorMessages[Index];
   }
+  ThreadLocalErrorMessages.clear();
+  return Message;
