From 6f19d0e169b6475e7c2e1fd58001e958e57614d0 Mon Sep 17 00:00:00 2001
From: Matt Hargett <plaztiksyke@gmail.com>
Date: Tue, 22 Sep 2026 16:28:51 -0700
Subject: wasmedge cache local function entry state

Rebased onto 0.17.2-rc.3. Upstream #5347 (with #4772) now initializes
ref-typed locals as nulls of their hierarchy's bottom type so that
ref.test/ref.cast match them; that needs Executor::toBottomType and the
module, so it cannot be precomputed in FunctionInstance. The cached
DefaultLocals fast path is therefore limited to functions whose locals
are all numeric (HasRefLocals == false); any function with a ref-typed
local runs upstream's per-local loop unchanged. The value-stack
reservation uses getLocalNum() so it is exact on both paths. The
compiled-function return loop conflict was #4850 comment rewording.
---
 include/runtime/instance/function.h | 31 +++++++++++++
 include/runtime/stackmgr.h          |  4 ++
 lib/executor/helper.cpp             | 67 +++++++++++++++++++++--------
 3 files changed, 84 insertions(+), 18 deletions(-)

diff --git a/include/runtime/instance/function.h b/include/runtime/instance/function.h
index 930118fa7..5f933eba0 100644
--- a/include/runtime/instance/function.h
+++ b/include/runtime/instance/function.h
@@ -110,6 +110,22 @@ public:
     return std::get_if<WasmFunction>(&Data)->Locals;
   }
 
+  Span<const ValVariant> getDefaultLocals() const noexcept {
+    if (const auto *WasmFunc = std::get_if<WasmFunction>(&Data)) {
+      return {WasmFunc->DefaultLocals.data(), WasmFunc->DefaultLocals.size()};
+    }
+    return {};
+  }
+
+  /// Whether any local is a reference type. Those need module-dependent
+  /// bottom-typed null values, so they bypass the cached default locals.
+  bool hasRefTypedLocals() const noexcept {
+    if (const auto *WasmFunc = std::get_if<WasmFunction>(&Data)) {
+      return WasmFunc->HasRefLocals;
+    }
+    return false;
+  }
+
   /// Getter for function local number.
   uint32_t getLocalNum() const noexcept {
     return std::get_if<WasmFunction>(&Data)->LocalNum;
@@ -221,6 +237,8 @@ private:
     const std::vector<std::pair<uint32_t, ValType>> Locals;
     const uint32_t LocalNum;
     const uint32_t MaxValueStackHeight;
+    std::vector<ValVariant> DefaultLocals;
+    bool HasRefLocals = false;
     AST::InstrVec Instrs;
     WasmFunction(Span<const std::pair<uint32_t, ValType>> Locs,
                  AST::InstrView Expr, uint32_t MaxStackHeight) noexcept
@@ -231,6 +249,19 @@ private:
                                 return N + Pair.first;
                               })),
           MaxValueStackHeight(MaxStackHeight) {
+      for (const auto &Def : Locals) {
+        if (Def.second.isRefType()) {
+          HasRefLocals = true;
+        }
+      }
+      if (!HasRefLocals) {
+        DefaultLocals.reserve(LocalNum);
+        for (const auto &Def : Locals) {
+          for (uint32_t I = 0; I < Def.first; ++I) {
+            DefaultLocals.push_back(ValueFromType(Def.second));
+          }
+        }
+      }
       // FIXME: Modify the capacity to prevent connecting 2 vectors.
       Instrs.reserve(Expr.size() + 1);
       Instrs.assign(Expr.begin(), Expr.end());
diff --git a/include/runtime/stackmgr.h b/include/runtime/stackmgr.h
index 7c8a30c1c..0adf0d962 100644
--- a/include/runtime/stackmgr.h
+++ b/include/runtime/stackmgr.h
@@ -84,6 +84,10 @@ public:
     ValueStack.insert(ValueStack.end(), ValVec.begin(), ValVec.end());
   }
 
+  void pushValSpan(Span<const Value> Values) {
+    ValueStack.insert(ValueStack.end(), Values.begin(), Values.end());
+  }
+
   void reserveAdditionalValues(size_t Additional) {
     const size_t Required = ValueStack.size() + Additional;
     if (ValueStack.capacity() < Required) {
diff --git a/lib/executor/helper.cpp b/lib/executor/helper.cpp
index 9f7903819..4f406c6f1 100644
--- a/lib/executor/helper.cpp
+++ b/lib/executor/helper.cpp
@@ -7,6 +7,7 @@
 #include "system/fault.h"
 #include "system/stacktrace.h"
 
+#include <array>
 #include <cstdint>
 #include <utility>
 #include <vector>
@@ -14,6 +15,22 @@
 namespace WasmEdge {
 namespace Executor {
 
+namespace {
+
+constexpr size_t kInlineReturnValueCount = 4U;
+
+Span<ValVariant> makeReturnStorage(
+    std::array<ValVariant, kInlineReturnValueCount> &InlineRets,
+    std::vector<ValVariant> &HeapRets, uint32_t Count) {
+  if (Count <= InlineRets.size()) {
+    return {InlineRets.data(), Count};
+  }
+  HeapRets.resize(Count);
+  return {HeapRets.data(), HeapRets.size()};
+}
+
+} // namespace
+
 Executor::SavedThreadLocal::SavedThreadLocal(
     Executor &Ex, Runtime::StackManager &StackMgr,
     const Runtime::Instance::FunctionInstance &Func) noexcept {
@@ -101,7 +118,9 @@ Executor::enterFunction(Runtime::StackManager &StackMgr,
       Stat->startRecordHost();
     }
 
-    std::vector<ValVariant> Rets(RetsN);
+    std::array<ValVariant, kInlineReturnValueCount> InlineRets{};
+    std::vector<ValVariant> HeapRets;
+    Span<ValVariant> Rets = makeReturnStorage(InlineRets, HeapRets, RetsN);
     auto Ret = [&]() {
       Fault::SignalTrapSuspend TrapSuspend;
 
@@ -161,7 +180,9 @@ Executor::enterFunction(Runtime::StackManager &StackMgr,
 
     // Prepare arguments.
     Span<ValVariant> Args = StackMgr.getTopSpan(ArgsN);
-    std::vector<ValVariant> Rets(RetsN);
+    std::array<ValVariant, kInlineReturnValueCount> InlineRets{};
+    std::vector<ValVariant> HeapRets;
+    Span<ValVariant> Rets = makeReturnStorage(InlineRets, HeapRets, RetsN);
     SavedThreadLocal Saved(*this, StackMgr, Func);
 
     ErrCode Err;
@@ -204,8 +225,8 @@ Executor::enterFunction(Runtime::StackManager &StackMgr,
     }
 
     // Push returns back to the stack.
-    for (uint32_t I = 0; I < Rets.size(); ++I) {
-      StackMgr.push(Rets[I]);
+    for (auto &R : Rets) {
+      StackMgr.push(std::move(R));
     }
 
     // As in the host case, step a tail-call continuation forward one
@@ -214,23 +235,33 @@ Executor::enterFunction(Runtime::StackManager &StackMgr,
     return IsTailCall ? Continuation + 1 : Continuation;
   } else {
     // Native function case: Jump to the start of the function body.
+    const auto InitialLocals = Func.getDefaultLocals();
+    const auto Instrs = Func.getInstrs();
 
     StackMgr.reserveAdditionalValues(
         static_cast<size_t>(Func.getLocalNum()) + Func.getMaxValueStackHeight());
 
-    // Push local variables into the stack.
-    for (auto &Def : Func.getLocals()) {
-      if (Def.second.isRefType()) {
-        // Type the null refs with the bottom heap type of their hierarchy so
-        // that ref.test/ref.cast match them against the concrete types.
-        const auto BotTypeCode = toBottomType(Func.getModule(), Def.second);
-        RefVariant InitVal(ValType(TypeCode::RefNull, BotTypeCode));
-        for (uint32_t I = 0; I < Def.first; I++) {
-          StackMgr.push(InitVal);
-        }
-      } else {
-        for (uint32_t I = 0; I < Def.first; I++) {
-          StackMgr.push(ValueFromType(Def.second));
+    if (!Func.hasRefTypedLocals()) {
+      // Numeric-only locals: push the zero values materialized once at
+      // instantiation rather than re-deriving each one per call.
+      if (!InitialLocals.empty()) {
+        StackMgr.pushValSpan(InitialLocals);
+      }
+    } else {
+      // Push local variables into the stack.
+      for (auto &Def : Func.getLocals()) {
+        if (Def.second.isRefType()) {
+          // Type the null refs with the bottom heap type of their hierarchy so
+          // that ref.test/ref.cast match them against the concrete types.
+          const auto BotTypeCode = toBottomType(Func.getModule(), Def.second);
+          RefVariant InitVal(ValType(TypeCode::RefNull, BotTypeCode));
+          for (uint32_t I = 0; I < Def.first; I++) {
+            StackMgr.push(InitVal);
+          }
+        } else {
+          for (uint32_t I = 0; I < Def.first; I++) {
+            StackMgr.push(ValueFromType(Def.second));
+          }
         }
       }
     }
@@ -247,7 +278,7 @@ Executor::enterFunction(Runtime::StackManager &StackMgr,
 
     // For native function case, the continuation will be the start of the
     // function body.
-    return Func.getInstrs().begin();
+    return Instrs.begin();
   }
 }
 
