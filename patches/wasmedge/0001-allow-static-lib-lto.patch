From 602aa42abd392a07f98dcc95174e9a5011434708 Mon Sep 17 00:00:00 2001
From: Matt Hargett <plaztiksyke@gmail.com>
Date: Tue, 22 Sep 2026 16:25:13 -0700
Subject: allow static lib lto

---
 CMakeLists.txt     | 7 +++++--
 cmake/Helper.cmake | 5 +++--
 2 files changed, 8 insertions(+), 4 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 6a563bbdc..a1109d54d 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -73,6 +73,7 @@ if(WASMEDGE_BUILD_AOT_RUNTIME)
 endif()
 option(WASMEDGE_USE_CXX11_ABI "Enable cxx11 abi when building WasmEdge." ON)
 option(WASMEDGE_FORCE_DISABLE_LTO "Forcefully disable link time optimization when linking even in Release/RelWithDeb build." OFF)
+option(WASMEDGE_STATIC_LIB_ENABLE_LTO "Allow link time optimization when building WasmEdge static libraries." OFF)
 option(WASMEDGE_LINK_LLVM_STATIC "Statically link the LLVM library into the WasmEdge tools and libraries." OFF)
 option(WASMEDGE_LINK_TOOLS_STATIC "Statically link the wasmedge and wasmedgec tools. Will forcefully link the LLVM library statically." OFF)
 option(WASMEDGE_ENABLE_UB_SANITIZER "Enable undefined behavior sanitizer." OFF)
@@ -134,8 +135,10 @@ if(WASMEDGE_BUILD_TESTS AND WASMEDGE_BUILD_FUZZING)
   message(FATAL_ERROR "unit tests and fuzzing tool are exclusive options.")
 endif()
 
-# Static library will forcefully turn off the LTO.
-if(WASMEDGE_BUILD_STATIC_LIB)
+# Static library builds historically forcefully turned off LTO. Keep that
+# behavior as the default, but allow explicit opt-in when the final link also
+# wants to consume LLVM bitcode from the archive members.
+if(WASMEDGE_BUILD_STATIC_LIB AND NOT WASMEDGE_STATIC_LIB_ENABLE_LTO)
   set(WASMEDGE_FORCE_DISABLE_LTO ON)
 endif()
 
diff --git a/cmake/Helper.cmake b/cmake/Helper.cmake
index cfa86bef7..1eb67bcf4 100644
--- a/cmake/Helper.cmake
+++ b/cmake/Helper.cmake
@@ -348,8 +348,9 @@ if((WASMEDGE_LINK_LLVM_STATIC OR WASMEDGE_BUILD_STATIC_LIB) AND WASMEDGE_USE_LLV
     list(APPEND WASMEDGE_LLVM_LINK_SHARED_COMPONENTS
       rt
     )
-    if(WASMEDGE_BUILD_STATIC_LIB)
-      # Static library will forcefully turn off the LTO.
+    if(WASMEDGE_BUILD_STATIC_LIB AND NOT WASMEDGE_STATIC_LIB_ENABLE_LTO)
+      # When the static library disables LTO, libz and libtinfo can be
+      # statically linked directly.
       # Therefore, libz and libtinfo can be statically linked.
       find_package(ZLIB REQUIRED)
       get_filename_component(ZLIB_PATH "${ZLIB_LIBRARIES}" DIRECTORY)
