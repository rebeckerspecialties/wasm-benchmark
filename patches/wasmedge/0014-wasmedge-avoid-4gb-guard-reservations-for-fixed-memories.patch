From febd9d6741a2868a8fc9697056488120f60c5649 Mon Sep 17 00:00:00 2001
From: Matt Hargett <plaztiksyke@gmail.com>
Date: Tue, 22 Sep 2026 16:27:17 -0700
Subject: wasmedge avoid 4gb guard reservations for fixed memories

Rebased onto 0.17.2-rc.3: context-only conflict with the #4850 comment
sweep in instantiate/memory.cpp.
---
 include/runtime/instance/memory.h     | 13 +++++++++++--
 include/runtime/instance/module.h     | 18 ++++++++++++++++++
 lib/executor/instantiate/function.cpp |  3 +++
 lib/executor/instantiate/memory.cpp   | 11 ++++++++++-
 4 files changed, 42 insertions(+), 3 deletions(-)

diff --git a/include/runtime/instance/memory.h b/include/runtime/instance/memory.h
index 62c8b4819..64e9a8008 100644
--- a/include/runtime/instance/memory.h
+++ b/include/runtime/instance/memory.h
@@ -49,18 +49,21 @@ public:
   MemoryInstance(MemoryInstance &&Inst) noexcept
       : MemType(Inst.MemType), DataPtr(Inst.DataPtr),
         PageLimit(Inst.PageLimit),
+        ReservedPageLimit(Inst.ReservedPageLimit),
         GuardPageBoundsCheck(Inst.GuardPageBoundsCheck),
         RequestedGuardPageBytes(Inst.RequestedGuardPageBytes),
         GuardedReservationBytes(Inst.GuardedReservationBytes) {
     Inst.DataPtr = nullptr;
+    Inst.ReservedPageLimit = 0;
     Inst.GuardPageBoundsCheck = false;
     Inst.RequestedGuardPageBytes = 0;
     Inst.GuardedReservationBytes = 0;
   }
   MemoryInstance(const AST::MemoryType &MType,
                  uint64_t PageLim = kPageLimit64,
-                 uint64_t GuardBytes = 0) noexcept
-      : MemType(MType), PageLimit(PageLim) {
+                 uint64_t GuardBytes = 0,
+                 uint64_t ReservedPageLim = 0) noexcept
+      : MemType(MType), PageLimit(PageLim), ReservedPageLimit(ReservedPageLim) {
     using namespace std::literals;
     if (MemType.getLimit().is32() && PageLimit > kPageLimit32) {
       if (PageLimit != kPageLimit64) {
@@ -85,6 +88,11 @@ public:
           std::min(ReservationPageCount, MemType.getLimit().getMax());
     }
     ReservationPageCount = std::min(ReservationPageCount, PageLimit);
+    if (ReservedPageLimit != 0) {
+      ReservationPageCount = std::min(ReservationPageCount, ReservedPageLimit);
+    }
+    ReservationPageCount =
+        std::max(ReservationPageCount, MemType.getLimit().getMin());
 
     RequestedGuardPageBytes = GuardBytes;
     DataPtr = Allocator::allocate(
@@ -488,6 +496,7 @@ private:
   AST::MemoryType MemType;
   uint8_t *DataPtr = nullptr;
   uint64_t PageLimit;
+  uint64_t ReservedPageLimit = 0;
   bool GuardPageBoundsCheck = false;
   uint64_t RequestedGuardPageBytes = 0;
   uint64_t GuardedReservationBytes = 0;
diff --git a/include/runtime/instance/module.h b/include/runtime/instance/module.h
index 8911fcedf..1c63edb8a 100644
--- a/include/runtime/instance/module.h
+++ b/include/runtime/instance/module.h
@@ -232,6 +232,7 @@ public:
   void reserveMemoryGuardPageBytes(uint32_t Count) {
     std::unique_lock Lock(Mutex);
     MemoryGuardPageBytes.resize(Count, 0U);
+    MemoryMayGrow.resize(Count, false);
   }
 
   void noteMemoryGuardPageBytes(uint32_t Idx, uint64_t GuardBytes) {
@@ -250,6 +251,22 @@ public:
     return MemoryGuardPageBytes[Idx];
   }
 
+  void noteMemoryMayGrow(uint32_t Idx) {
+    std::unique_lock Lock(Mutex);
+    if (Idx >= MemoryMayGrow.size()) {
+      MemoryMayGrow.resize(static_cast<size_t>(Idx) + 1U, false);
+    }
+    MemoryMayGrow[Idx] = true;
+  }
+
+  bool getMemoryMayGrow(uint32_t Idx) const noexcept {
+    std::shared_lock Lock(Mutex);
+    if (Idx >= MemoryMayGrow.size()) {
+      return true;
+    }
+    return MemoryMayGrow[Idx];
+  }
+
 protected:
   friend class Executor::Executor;
   friend class ComponentInstance;
@@ -606,6 +623,7 @@ protected:
   std::vector<ElementInstance *> ElemInsts;
   std::vector<DataInstance *> DataInsts;
   std::vector<uint64_t> MemoryGuardPageBytes;
+  std::vector<bool> MemoryMayGrow;
 
   /// Imported instance counts.
   uint32_t ImpGlobalNum = 0;
diff --git a/lib/executor/instantiate/function.cpp b/lib/executor/instantiate/function.cpp
index 85ac8b770..1ef0dd6ed 100644
--- a/lib/executor/instantiate/function.cpp
+++ b/lib/executor/instantiate/function.cpp
@@ -138,6 +138,9 @@ uint64_t getMemoryAccessSize(const AST::Instruction &Instr) noexcept {
 void noteMemoryGuardPageBytes(Runtime::Instance::ModuleInstance &ModInst,
                               AST::InstrView Instrs) {
   for (const auto &Instr : Instrs) {
+    if (Instr.getOpCode() == OpCode::Memory__grow) {
+      ModInst.noteMemoryMayGrow(Instr.getTargetIndex());
+    }
     const uint64_t AccessSize = getMemoryAccessSize(Instr);
     if (AccessSize == 0U) {
       continue;
diff --git a/lib/executor/instantiate/memory.cpp b/lib/executor/instantiate/memory.cpp
index 6cb30c431..dd90e643a 100644
--- a/lib/executor/instantiate/memory.cpp
+++ b/lib/executor/instantiate/memory.cpp
@@ -28,9 +28,18 @@ Expect<void> Executor::instantiate(Runtime::Instance::ModuleInstance &ModInst,
   // Iterate through the memory types to instantiate memory instances.
   for (uint32_t I = 0; I < MemTypes.size(); ++I) {
     const uint32_t Index = ImportedMemoryCount + I;
+    uint64_t ReservationPageCount = MemTypes[I].getLimit().getMin();
+    if (ModInst.getMemoryMayGrow(Index)) {
+      ReservationPageCount = Conf.getRuntimeConfigure().getMaxMemoryPage();
+      if (MemTypes[I].getLimit().hasMax()) {
+        ReservationPageCount =
+            std::min(ReservationPageCount, MemTypes[I].getLimit().getMax());
+      }
+    }
     // Create and add the memory instance to the module instance.
     ModInst.addMemory(MemTypes[I], Conf.getRuntimeConfigure().getMaxMemoryPage(),
-                      ModInst.getMemoryGuardPageBytes(Index));
+                      ModInst.getMemoryGuardPageBytes(Index),
+                      ReservationPageCount);
     Runtime::Instance::MemoryInstance *MemInst = *ModInst.getMemory(Index);
     // Set the memory pointers of instantiated memories.
 #if WASMEDGE_ALLOCATOR_IS_STABLE
