+constexpr uint32_t kPackedStackOffsetBits = 16U;
+constexpr uint32_t kPackedStackOffsetMask =
+    (1U << kPackedStackOffsetBits) - 1U;
+
+inline uint32_t unpackLowStackOffset(uint32_t Packed) noexcept {
+  return Packed & kPackedStackOffsetMask;
+}
+
+inline uint32_t unpackHighStackOffset(uint32_t Packed) noexcept {
+  return Packed >> kPackedStackOffsetBits;
+}
+
