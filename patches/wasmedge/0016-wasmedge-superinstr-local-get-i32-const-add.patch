+Expect<void> Executor::runLocalGetI32ConstAddOp(
+    Runtime::StackManager &StackMgr, const AST::Instruction &Instr,
+    AST::InstrView::iterator &PC) const noexcept {
+  const uint32_t Base =
+      StackMgr.getTopN(Instr.getInternalArgument2()).get<uint32_t>();
+  StackMgr.push(Base + Instr.getInternalArgument0());
+  PC += 2;
+  return {};
+}
