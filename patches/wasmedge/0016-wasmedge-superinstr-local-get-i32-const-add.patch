diff --git a/lib/executor/superinstr.cpp b/lib/executor/superinstr.cpp
new file mode 100644
index 0000000..006cb87
--- /dev/null
+++ b/lib/executor/superinstr.cpp
@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: 2019-2024 Second State INC
+
+#include "runtime/instance/function.h"
+
+namespace WasmEdge {
+namespace Runtime {
+namespace Instance {
+
+void FunctionInstance::fuseSuperInstructions(AST::InstrVec &Instrs) noexcept {
+  for (size_t I = 0; I + 2 < Instrs.size(); ++I) {
+    if (Instrs[I].getOpCode() != OpCode::Local__get ||
+        Instrs[I + 1].getOpCode() != OpCode::I32__const ||
+        Instrs[I + 2].getOpCode() != OpCode::I32__add) {
+      continue;
+    }
+
+    AST::Instruction Fused(OpCode::Internal__LocalGetI32ConstAdd,
+                           Instrs[I].getOffset());
+    Fused.getInternalArgument0() = Instrs[I + 1].getNum().get<uint32_t>();
+    Fused.getInternalArgument2() = Instrs[I].getStackOffset();
+    Instrs[I] = std::move(Fused);
+    Instrs[I + 1] = AST::Instruction(OpCode::Nop, Instrs[I + 1].getOffset());
+    Instrs[I + 2] = AST::Instruction(OpCode::Nop, Instrs[I + 2].getOffset());
+    I += 2;
+  }
+}
+
+} // namespace Instance
+} // namespace Runtime
+} // namespace WasmEdge
