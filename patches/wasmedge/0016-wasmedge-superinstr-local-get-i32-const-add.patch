+  const auto CostTable = Stat.getCostTable();
+  switch (Code) {
+  case OpCode::Internal__LocalGetI32ConstAdd:
+    return CostTable[uint16_t(OpCode::Local__get)] +
+           CostTable[uint16_t(OpCode::I32__const)] +
+           CostTable[uint16_t(OpCode::I32__add)];
+  default:
+    return CostTable[uint16_t(Code)];
+  }
+}
