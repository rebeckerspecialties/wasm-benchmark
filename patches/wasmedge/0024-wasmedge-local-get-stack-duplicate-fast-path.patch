From 87213a175a34874cc7cd88e57c73013ffba45980 Mon Sep 17 00:00:00 2001
From: Matt Hargett <plaztiksyke@gmail.com>
Date: Tue, 22 Sep 2026 16:29:01 -0700
Subject: wasmedge local get stack duplicate fast path

Rebased onto 0.17.2-rc.3: context-only conflict with the #4850 comment
sweep in stackmgr.h.
---
 include/runtime/stackmgr.h            | 14 ++++++++++++++
 lib/executor/engine/variableInstr.cpp |  2 +-
 2 files changed, 15 insertions(+), 1 deletion(-)

diff --git a/include/runtime/stackmgr.h b/include/runtime/stackmgr.h
index 0adf0d962..d80af7f00 100644
--- a/include/runtime/stackmgr.h
+++ b/include/runtime/stackmgr.h
@@ -16,7 +16,9 @@
 #include "ast/instruction.h"
 #include "runtime/instance/module.h"
 
+#include <cstring>
 #include <optional>
+#include <type_traits>
 #include <vector>
 
 namespace WasmEdge {
@@ -79,6 +81,18 @@ public:
     ValueStack.push_back(std::forward<T>(Val));
   }
 
+  void duplicateTopN(uint32_t Offset) {
+    assuming(0 < Offset && Offset <= ValueStack.size());
+    static_assert(std::is_trivially_copyable_v<Value>);
+    const size_t SrcIndex = ValueStack.size() - Offset;
+    reserveAdditionalValues(1);
+    ValueStack.emplace_back();
+    // `local.get` frequently duplicates an existing in-stack `ValVariant`.
+    // Keeping that as an indexed self-copy avoids the libc++ append helper that
+    // showed up under `runLocalGetOp` in active-driving M4 traces.
+    std::memcpy(&ValueStack.back(), &ValueStack[SrcIndex], sizeof(Value));
+  }
+
   /// Push a vector of values to the stack.
   void pushValVec(const std::vector<Value> &ValVec) {
     ValueStack.insert(ValueStack.end(), ValVec.begin(), ValVec.end());
diff --git a/lib/executor/engine/variableInstr.cpp b/lib/executor/engine/variableInstr.cpp
index cb0c25cd4..ae4fc91e8 100644
--- a/lib/executor/engine/variableInstr.cpp
+++ b/lib/executor/engine/variableInstr.cpp
@@ -253,7 +253,7 @@ Expect<void> Executor::runLocalGetLocalGetI32StoreOp(
 
 Expect<void> Executor::runLocalGetOp(Runtime::StackManager &StackMgr,
                                      uint32_t StackOffset) const noexcept {
-  StackMgr.push(StackMgr.getTopN(StackOffset));
+  StackMgr.duplicateTopN(StackOffset);
   return {};
 }
 
