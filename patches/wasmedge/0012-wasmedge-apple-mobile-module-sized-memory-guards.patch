+
+void noteMemoryGuardPageBytes(Runtime::Instance::ModuleInstance &ModInst,
+                              AST::InstrView Instrs) {
+  for (const auto &Instr : Instrs) {
+    const uint64_t AccessSize = getMemoryAccessSize(Instr);
+    if (AccessSize == 0U) {
+      continue;
+    }
+    uint64_t GuardBytes = 0;
+#if defined(_MSC_VER) && !defined(__clang__)
+    if (std::numeric_limits<uint64_t>::max() - Instr.getMemoryOffset() <
+        AccessSize) {
+      GuardBytes = std::numeric_limits<uint64_t>::max();
+    } else {
+      GuardBytes = Instr.getMemoryOffset() + AccessSize;
+    }
+#else
+    if (__builtin_add_overflow(Instr.getMemoryOffset(), AccessSize,
+                               &GuardBytes)) {
+      GuardBytes = std::numeric_limits<uint64_t>::max();
+    }
+#endif
+    ModInst.noteMemoryGuardPageBytes(Instr.getTargetIndex(), GuardBytes);
+  }
+}
