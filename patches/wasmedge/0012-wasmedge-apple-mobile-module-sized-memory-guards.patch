+uint8_t *allocateGuardedAppleMobile(uint64_t PageCount,
+                                    uint64_t ReservedPageCount,
+                                    uint64_t GuardPageBytes,
+                                    uint64_t *GuardedReservationBytes) noexcept {
+  const uint64_t AlignedGuardPageBytes = alignGuardPageBytes(GuardPageBytes);
+  uint64_t ReservationBytes = 0;
+  if (ReservedPageCount > std::numeric_limits<uint64_t>::max() / kPageSize) {
+    return nullptr;
+  }
+  ReservationBytes = ReservedPageCount * kPageSize;
+  if (std::numeric_limits<uint64_t>::max() - ReservationBytes <
+      AlignedGuardPageBytes) {
+    return nullptr;
+  }
+  ReservationBytes += AlignedGuardPageBytes;
+  auto *Reserved = reinterpret_cast<uint8_t *>(
+      mmap(nullptr, ReservationBytes, PROT_NONE,
+           MAP_PRIVATE | MAP_ANONYMOUS, -1, 0));
+  if (Reserved == MAP_FAILED) {
+    return nullptr;
+  }
+  if (PageCount != 0 &&
+      mmap(Reserved, PageCount * kPageSize, PROT_READ | PROT_WRITE,
+           MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1,
+           0) == MAP_FAILED) {
+    munmap(Reserved, ReservationBytes);
+    return nullptr;
+  }
+  if (GuardedReservationBytes != nullptr) {
+    *GuardedReservationBytes = ReservationBytes;
+  }
+  return Reserved;
+}
 #endif
 
