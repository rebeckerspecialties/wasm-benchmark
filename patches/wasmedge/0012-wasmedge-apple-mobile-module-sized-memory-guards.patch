+uint64_t alignGuardPageBytes(uint64_t GuardPageBytes) noexcept {
+  if (GuardPageBytes == 0) {
+    return 0;
+  }
+  const uint64_t Remainder = GuardPageBytes % kPageSize;
+  if (Remainder == 0) {
+    return GuardPageBytes;
+  }
+  return GuardPageBytes + (kPageSize - Remainder);
+}
