+Expect<void> Executor::runLocalGetI32ConstAddLocalTeeOp(
+    Runtime::StackManager &StackMgr, const AST::Instruction &Instr,
+    AST::InstrView::iterator &PC) const noexcept {
+  const uint32_t PackedOffsets = Instr.getInternalArgument1();
+  const uint32_t BaseStackOffset = unpackLowStackOffset(PackedOffsets);
+  const uint32_t TeeStackOffset = unpackHighStackOffset(PackedOffsets);
+  const uint32_t Result =
+      StackMgr.getTopN(BaseStackOffset).get<uint32_t>() +
+      Instr.getInternalArgument0();
+  StackMgr.push(Result);
+  StackMgr.getTopN(TeeStackOffset) = StackMgr.getTop();
+  PC += 3;
+  return {};
+}
