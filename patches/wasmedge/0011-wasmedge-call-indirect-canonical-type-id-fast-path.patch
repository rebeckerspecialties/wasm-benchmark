+  static uint32_t canonicalizeFuncTypeId(const AST::FunctionType &Type) noexcept {
+    struct FuncTypeKey {
+      std::vector<uint64_t> Words;
+
+      bool operator==(const FuncTypeKey &Other) const noexcept {
+        return Words == Other.Words;
+      }
+    };
+
+    struct FuncTypeKeyHash {
+      size_t operator()(const FuncTypeKey &Key) const noexcept {
+        size_t Hash = 1469598103934665603ULL;
+        for (const auto Word : Key.Words) {
+          Hash ^= static_cast<size_t>(Word);
+          Hash *= 1099511628211ULL;
+        }
+        return Hash;
+      }
+    };
+
+    auto appendValType = [](FuncTypeKey &Key, const ValType &VT) noexcept {
+      if (VT.isRefType() && VT.getHeapTypeCode() == TypeCode::TypeIndex) {
+        return false;
+      }
+      uint64_t Bits = static_cast<uint64_t>(
+          static_cast<std::underlying_type_t<TypeCode>>(VT.getCode()));
+      Bits |= static_cast<uint64_t>(
+                  static_cast<std::underlying_type_t<TypeCode>>(
+                      VT.getHeapTypeCode()))
+              << 8U;
+      Bits |= static_cast<uint64_t>(VT.getTypeIndex()) << 16U;
+      Key.Words.push_back(Bits);
+      return true;
+    };
+
+    FuncTypeKey Key;
+    const auto &Params = Type.getParamTypes();
+    const auto &Rets = Type.getReturnTypes();
+    Key.Words.reserve(Params.size() + Rets.size() + 2U);
+    Key.Words.push_back(static_cast<uint64_t>(Params.size()));
+    Key.Words.push_back(static_cast<uint64_t>(Rets.size()));
+    for (const auto &VT : Params) {
+      if (!appendValType(Key, VT)) {
+        return NoCanonicalFuncTypeId;
+      }
+    }
+    for (const auto &VT : Rets) {
+      if (!appendValType(Key, VT)) {
+        return NoCanonicalFuncTypeId;
+      }
+    }
+
+    static std::shared_mutex MapMutex;
+    static std::unordered_map<FuncTypeKey, uint32_t, FuncTypeKeyHash> TypeIds;
+    static std::atomic<uint32_t> NextId{1U};
+
+    {
+      std::shared_lock Lock(MapMutex);
+      if (const auto Iter = TypeIds.find(Key); Iter != TypeIds.cend()) {
+        return Iter->second;
+      }
+    }
+
+    std::unique_lock Lock(MapMutex);
+    if (const auto Iter = TypeIds.find(Key); Iter != TypeIds.cend()) {
+      return Iter->second;
+    }
+    const uint32_t NewId = NextId.fetch_add(1U, std::memory_order_relaxed);
+    const auto [Iter, Inserted] = TypeIds.emplace(std::move(Key), NewId);
+    static_cast<void>(Inserted);
+    return Iter->second;
+  }
+
 private:
   struct WasmFunction {
     const std::vector<std::pair<uint32_t, ValType>> Locals;
