@@ -8,6 +8,35 @@
 namespace WasmEdge {
 namespace Executor {
 
+bool Executor::matchCallIndirectType(
+    const Runtime::Instance::ModuleInstance &ModInst, uint32_t TypeIdx,
+    const Runtime::Instance::FunctionInstance &FuncInst) const noexcept {
+  const uint32_t ExpTypeId = ModInst.getCanonicalFuncTypeId(TypeIdx);
+  const uint32_t GotTypeId = FuncInst.getCanonicalFuncTypeId();
+  if (likely(ExpTypeId != Runtime::Instance::FunctionInstance::
+                              NoCanonicalFuncTypeId &&
+             GotTypeId != Runtime::Instance::FunctionInstance::
+                              NoCanonicalFuncTypeId &&
+             ExpTypeId == GotTypeId)) {
+    return true;
+  }
+
+  const auto *ExpDefType = ModInst.unsafeGetType(TypeIdx);
+  assuming(ExpDefType);
+  if (FuncInst.getModule()) {
+    return AST::TypeMatcher::matchType(ModInst.getTypeList(),
+                                       *ExpDefType->getTypeIndex(),
+                                       FuncInst.getModule()->getTypeList(),
+                                       FuncInst.getTypeIndex());
+  }
+
+  // Independent host module instance case. Matching the composite type
+  // directly.
+  return AST::TypeMatcher::matchType(
+      ModInst.getTypeList(), ExpDefType->getCompositeType(),
+      FuncInst.getHostFunc().getDefinedType().getCompositeType());
+}
